{
  "name": "hetzner-mcp",
  "version": "0.1.0",
  "description": "MCP server for Hetzner Cloud via the hcloud CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hetzner-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
