# Hetzner Cloud API token (required for API calls)
HCLOUD_TOKEN=

# Path to hcloud binary (default: hcloud on PATH)
# HCLOUD_MCP_HCLOUD_PATH=hcloud

# Command timeout in milliseconds (default: 30000)
# HCLOUD_MCP_DEFAULT_TIMEOUT_MS=30000

# Allow destructive operations (default: false)
# HCLOUD_MCP_ALLOW_DESTRUCTIVE=false

# Log level: debug | info | warn | error (default: info)
# HCLOUD_MCP_LOG_LEVEL=info
